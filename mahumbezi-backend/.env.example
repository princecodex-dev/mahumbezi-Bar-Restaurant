# Copy this file to .env and fill in real values before running.

# --- Database ---
# Path to the SQLite file. On a VPS this just lives on disk.
# On Render/Railway, point this at a mounted persistent volume/disk if you use
# their free ephemeral filesystem, data is lost on redeploy — see README.
DATABASE_PATH="./data/mahumbezi.db"

# --- Auth ---
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET="replace-this-with-a-long-random-string"

# --- Server ---
PORT=4000
# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CORS_ORIGIN="http://localhost:3000"
# Set to "true" ONLY when this server sits behind a reverse proxy (nginx,
# Render, Railway, ...). It makes rate limiting and IP logging use the real
# client IP instead of the proxy's. Leave unset/false for local dev or if
# this process is directly internet-facing (no proxy in front).
TRUST_PROXY=false

# --- Seed admin account (used once by scripts/seed.js) ---
SEED_ADMIN_EMAIL="kevin@mahumbezi.rw"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Google OAuth (Google Identity Services) ---
# The "web" client ID from Google Cloud Console (Auth Platform > Credentials)
GOOGLE_CLIENT_ID=""

# --- Payments ---
# "mock" (default) records Mobile Money as a staff-asserted payment with
# provider "mock". "live" pushes a real collection to the customer's phone and
# only marks the order Paid once the gateway confirms.
PAYMENT_PROVIDER_MODE="mock"
# Only needed for the legacy "Mobile Money" method, which carries no network
# of its own. The cashier's screen offers "MTN MoMo" and "Airtel Money" by
# name, so both networks can be live at once without this being set — just
# fill in whichever credentials you have.
MOBILE_MONEY_PROVIDER=""
# Country code used to normalise phone numbers typed as 078... (Rwanda)
PAYMENT_COUNTRY_CODE="250"
# How long a single payment request waits for the customer's PIN before the
# API answers 202 and the cashier's screen starts polling instead.
PAYMENT_SETTLE_BUDGET_MS=15000
PAYMENT_POLL_INTERVAL_MS=2000

# MTN MoMo Collections — see src/lib/payments/mtnMomo.js
# MTN_MOMO_SUBSCRIPTION_KEY=""
# MTN_MOMO_API_USER=""
# MTN_MOMO_API_KEY=""
# MTN_MOMO_TARGET_ENVIRONMENT="sandbox"   # sandbox | mtnrwanda
# MTN_MOMO_BASE_URL=""
# MTN_MOMO_CALLBACK_URL=""
# The MTN sandbox rejects RWF with INVALID_CURRENCY, so the provider swaps in
# this currency for sandbox calls only (the ledger records what was sent).
# Irrelevant once MTN_MOMO_TARGET_ENVIRONMENT=mtnrwanda.
# MTN_MOMO_SANDBOX_CURRENCY="EUR"

# Airtel Money — see src/lib/payments/airtel.js
# Sign up at https://developers.airtel.africa (pick Rwanda), register an app,
# then copy the key pair from Key Management.
# WARNING: AIRTEL_ENV defaults to "production" when unset, so it will hit the
# real API if you forget it. Set "sandbox" (https://openapiuat.airtel.africa)
# until Airtel has approved you for live.
# AIRTEL_CLIENT_ID=""
# AIRTEL_CLIENT_SECRET=""
# AIRTEL_ENV="sandbox"                     # sandbox | production  (defaults to production!)
# AIRTEL_COUNTRY="RW"
# AIRTEL_CURRENCY="RWF"
# AIRTEL_BASE_URL=""
# AIRTEL_NOTIFY_URL=""
