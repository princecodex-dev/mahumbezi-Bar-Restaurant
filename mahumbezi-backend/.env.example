# Copy this file to .env and fill in real values before running.

# --- Database ---
# Path to the SQLite file. On a VPS this just lives on disk.
# On Render/Railway, point this at a mounted persistent volume/disk if you use
# their free ephemeral filesystem, data is lost on redeploy — see README.
DATABASE_PATH="./data/mahumbezi.db"

# --- Auth ---
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET="replace-this-with-a-long-random-string"

# --- Server ---
PORT=4000
# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CORS_ORIGIN="http://localhost:3000"
# Set to "true" ONLY when this server sits behind a reverse proxy (nginx,
# Render, Railway, ...). It makes rate limiting and IP logging use the real
# client IP instead of the proxy's. Leave unset/false for local dev or if
# this process is directly internet-facing (no proxy in front).
TRUST_PROXY=false

# --- Seed admin account (used once by scripts/seed.js) ---
SEED_ADMIN_EMAIL="kevin@mahumbezi.rw"
SEED_ADMIN_PASSWORD="ChangeMe123!"
